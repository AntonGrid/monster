# ENRG Monster — paper configuration.
# Copy to .env and export, or pass the variables explicitly.  There are no
# secrets in this file and none are read by this package: the venue keys belong
# to the Rust hands, never to the research loop.
#
# MONSTER_MODE accepts only "paper".  A live mode is not a flag here.
MONSTER_MODE=paper
MONSTER_VENUE=htx

# Venues allowed to check the trading venue's prices.  The trading venue has to
# be in this list: a venue you trade must be a venue you check.
MONSTER_TRUTH_VENUES=htx,okx,bybit

# Book size and per-leg size, in USD.
MONSTER_CAPITAL_USD=1000
MONSTER_NOTIONAL_USD=100

# Costs the paper venue charges.  Zero fees is a bug, not an optimisation.
MONSTER_FEE_BPS=5
MONSTER_SLIPPAGE_BPS=2
MONSTER_LEVERAGE=2

# Carry: hold this long, and only take it if the net edge clears the threshold.
MONSTER_HORIZON_HOURS=168
MONSTER_MIN_EDGE_BPS=10
MONSTER_CLOSE_AFTER_HOURS=168

# Risk.  A limit that never fires is either sized perfectly or decorative.
MONSTER_MAX_GROSS_USD=2000
MONSTER_MAX_NET_DELTA_USD=200
MONSTER_MAX_SYMBOL_USD=1000
MONSTER_MAX_VENUE_USD=2000
MONSTER_MAX_LEVERAGE=2
MONSTER_MAX_DAILY_LOSS_USD=20
MONSTER_MIN_FREE_CASH_USD=50

# Coherence reading: window in samples, surrogates for the null, fixed seed so
# a reading can be reproduced and argued about.
MONSTER_COHERENCE_WINDOW=128
MONSTER_SURROGATES=200
MONSTER_SEED=0

# Where the memory and the cache live.  One writer per chain: the collector owns
# journal.capture.jsonl, the cycle owns journal.jsonl, and MONSTER_DATA_JOURNAL
# tells the cycle which capture chain to link by hash.
MONSTER_JOURNAL=var/journal.jsonl
MONSTER_STATE=var/state.json
MONSTER_DATA_JOURNAL=var/journal.capture.jsonl
# A --store cycle that means "as of now" refuses a capture pass older than this
# many seconds: three intervals, so one lost pass is a gap and three is a fault.
# Zero disables the check for a deliberate replay of an old store.
MONSTER_MAX_SNAPSHOT_AGE_S=180

# The data layer: where the day files live, the capture cadence, and how old a
# reading may be before it is dropped from a snapshot (quotes) or declared
# unmeasured (funding).  The freshness window is a veto, not a preference.
MONSTER_DATA_PATH=var/data
MONSTER_INTERVAL_S=60
MONSTER_MAX_QUOTE_AGE_S=5
MONSTER_MAX_FUNDING_AGE_H=12
