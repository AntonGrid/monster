[Unit]
Description=ENRG Monster schema probe — do the venues still answer the shape the parsers expect?
Documentation=file://<INSTALL_DIR>/docs/VPS.md
After=network-online.target time-sync.target
Wants=network-online.target time-sync.target

[Service]
Type=oneshot
User=<USER>
WorkingDirectory=<INSTALL_DIR>
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/bin/mkdir -p <INSTALL_DIR>/var/log
# A venue can answer 200 with a payload it no longer means: the collector would
# keep writing rows, the audit would keep agreeing with itself, and the week
# would be worthless in a way nobody notices until day 8.  Probe asks the same
# 18 endpoints, parses them with the same parsers capture uses, writes nothing
# to the store, and exits 1 the moment a shape moves.
ExecStart=/bin/sh -c 'echo "== $(date -u +%%FT%%TZ) probe --live"; exec <INSTALL_DIR>/.venv/bin/python -m monster.data probe --live'
StandardOutput=append:<INSTALL_DIR>/var/log/probe.log
StandardError=append:<INSTALL_DIR>/var/log/probe.log
