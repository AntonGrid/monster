[Unit]
Description=ENRG Monster capture — HTX/OKX/Bybit public quotes and funding (paper, no keys)
Documentation=file://<INSTALL_DIR>/docs/VPS.md
After=network-online.target time-sync.target
Wants=network-online.target time-sync.target

[Service]
Type=simple
User=<USER>
WorkingDirectory=<INSTALL_DIR>
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/bin/mkdir -p <INSTALL_DIR>/var/log
# 10080 passes at 60 s = one week.  The loop wakes on an absolute grid, so a
# slow answer becomes a recorded Gap instead of a drifting schedule.
# The collector writes its own chain: two writers on one journal interleave
# prev/hash and break it, so the cycle keeps var/journal.jsonl to itself and
# links this chain's head as a journal.linked event.
ExecStart=<INSTALL_DIR>/.venv/bin/python -m monster.data capture --live --store var/data --interval 60 --count 10080 --journal var/journal.capture.jsonl --fsync
Restart=always
RestartSec=10
# Restart=always means a crash costs seconds, not a week of data.
Nice=5
StandardOutput=append:<INSTALL_DIR>/var/log/capture.log
StandardError=append:<INSTALL_DIR>/var/log/capture.log

[Install]
WantedBy=multi-user.target
