[Unit]
Description=ENRG Monster capture — HTX/OKX/Bybit public quotes and funding (paper, no keys)
Documentation=file://<HOME>/entrain-core-workspace/monster/docs/VPS.md
After=network-online.target time-sync.target
Wants=network-online.target time-sync.target

[Service]
Type=simple
User=<USER>
WorkingDirectory=<HOME>/entrain-core-workspace/monster
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/bin/mkdir -p <HOME>/entrain-core-workspace/monster/var/log
# 10080 passes at 60 s = one week.  The loop wakes on an absolute grid, so a
# slow answer becomes a recorded Gap instead of a drifting schedule.
ExecStart=<HOME>/entrain-core-workspace/monster/.venv/bin/python -m monster.data capture --live --store var/data --interval 60 --count 10080 --journal var/journal.jsonl --fsync
Restart=always
RestartSec=10
# Restart=always means a crash costs seconds, not a week of data.
Nice=5
StandardOutput=append:<HOME>/entrain-core-workspace/monster/var/log/capture.log
StandardError=append:<HOME>/entrain-core-workspace/monster/var/log/capture.log

[Install]
WantedBy=multi-user.target
