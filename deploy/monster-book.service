[Unit]
Description=ENRG Monster hourly book audit — the cache must still be the journal's book
Documentation=file://<HOME>/entrain-core-workspace/monster/docs/VPS.md
After=monster-capture.service

[Service]
Type=oneshot
User=<USER>
WorkingDirectory=<HOME>/entrain-core-workspace/monster
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/bin/mkdir -p <HOME>/entrain-core-workspace/monster/var/log
# Two questions, in this order, because the second is meaningless if the first fails:
#   1. is the book's chain intact, and are the capture chains it linked still the
#      chains it read?  (`--verify` re-checks every journal.linked head)
#   2. does the state cache still describe the same book as the chain?  (`--replay`)
# A nonzero exit is the alert — that is the whole monitoring design.  This unit
# must never be green while the beast disagrees with its own memory, so no
# `SuccessExitStatus=` here: every code is a fact worth reading.
ExecStart=/bin/sh -c 'exec <HOME>/entrain-core-workspace/monster/.venv/bin/python -m monster.cycle --verify && exec <HOME>/entrain-core-workspace/monster/.venv/bin/python -m monster.cycle --replay'
StandardOutput=append:<HOME>/entrain-core-workspace/monster/var/log/book.log
StandardError=append:<HOME>/entrain-core-workspace/monster/var/log/book.log
